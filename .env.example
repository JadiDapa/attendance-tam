# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance_system?schema=public"

# Clerk — ambil dari dashboard.clerk.com > API Keys. Login pakai strategi
# email+password; akun karyawan hanya bisa dibuat admin (lewat menu Rekapan
# Karyawan), bukan self sign-up — jangan aktifkan sign-up di Clerk Dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Akun default yang dipakai prisma/seed.ts (opsional). Harus sudah dibuat di
# Clerk lebih dulu (Dashboard atau API) dengan email yang sama, lalu clerkId-nya
# diisi di sini.
SEED_ADMIN_EMAIL="admin@tam.test"
SEED_ADMIN_CLERK_ID=""
SEED_EMPLOYEE_EMAIL="karyawan@tam.test"
SEED_EMPLOYEE_CLERK_ID=""
SEED_SUPERVISOR_EMAIL="supervisor@tam.test"
SEED_SUPERVISOR_CLERK_ID=""
SEED_MANAGER_EMAIL="manager@tam.test"
SEED_MANAGER_CLERK_ID=""

# Zona waktu yang dipakai server untuk menentukan "hari kerja" & keterlambatan
APP_TIMEZONE="Asia/Jakarta"

# Layanan face recognition (FastAPI + DeepFace). Berjalan di internal network —
# tidak boleh exposed ke internet. Next.js server yang memanggilnya, bukan browser.
FACE_API_URL="http://localhost:8000"
# Header rahasia yang dicek FastAPI supaya hanya server Next.js yang bisa memanggilnya.
FACE_API_SECRET=""
# INFORMATIONAL SAJA — tidak dibaca kode Next.js mana pun. Ambang yang
# benar-benar dipakai ada di FACE_MATCH_THRESHOLD pada .env layanan DeepFace
# (face-api-backend/.env). Isi di sini cuma dokumentasi supaya kedua tim tahu
# nilai apa yang sedang dipakai — kalau mau mengubah ambangnya, ubah di sana.
FACE_MATCH_THRESHOLD="0.68"
# Minimal embedding tersimpan sebelum karyawan dianggap sudah enroll wajah.
FACE_ENROLLMENT_MIN_PHOTOS="1"
# Jumlah foto yang disarankan ke karyawan lewat UI (bukan batas keras).
FACE_ENROLLMENT_RECOMMENDED_PHOTOS="3"
# Maksimal embedding tersimpan per karyawan — batas atas tombol "Tambah foto lagi".
FACE_ENROLLMENT_MAX_PHOTOS="5"
