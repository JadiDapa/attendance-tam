# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance_system?schema=public"

# Auth.js — generate dengan: npx auth secret  (atau: openssl rand -base64 32)
AUTH_SECRET=""
# URL aplikasi (wajib di production)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Akun default yang dibuat oleh prisma/seed.ts (opsional)
SEED_ADMIN_EMAIL="admin@tam.test"
SEED_ADMIN_PASSWORD="admin123"
SEED_EMPLOYEE_EMAIL="karyawan@tam.test"
SEED_EMPLOYEE_PASSWORD="karyawan123"

# Zona waktu yang dipakai server untuk menentukan "hari kerja" & keterlambatan
APP_TIMEZONE="Asia/Jakarta"
