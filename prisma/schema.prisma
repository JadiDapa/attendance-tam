generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  ADMIN
  SUPERVISOR
  MANAGER
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum LeaveType {
  IZIN
  SAKIT
  CUTI
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Giliran approval untuk satu pengajuan izin/cuti/sakit — satu langkah saja,
/// ditentukan dari role pemohon (lihat `resolveInitialLeaveStage` di
/// `lib/leave.ts`): karyawan/admin menunggu `SUPERVISOR`, supervisor menunggu
/// `MANAGER`, manager disetujui otomatis (langsung `DONE`). Penolakan juga
/// langsung melompat ke `DONE` (lihat `LeaveRequest.status`).
enum LeaveStage {
  SUPERVISOR
  MANAGER
  DONE
}

enum HolidayType {
  NASIONAL
  CUTI_BERSAMA
  INTERNAL
}

/// Kategori alasan pengajuan izin/cuti ("Alasan" pada form). Wajib diisi untuk
/// `CUTI`/`IZIN` (lihat `CUTI_REASON_CATEGORIES`/`IZIN_REASON_CATEGORIES` di
/// `lib/leave.ts`), dan wajib null untuk `SAKIT` — Sakit hanya punya `detail`.
enum LeaveReasonCategory {
  CUTI_TAHUNAN
  CUTI_KHUSUS
  MELAHIRKAN
  MENIKAH
  IZIN_PRIBADI
  IZIN_KELUARGA
  KEPERLUAN_MENDESAK
  DATANG_TERLAMBAT
  PULANG_LEBIH_AWAL
  TIDAK_MASUK
  LAINNYA
}

/// Moda transportasi dinas luar ("Transportasi" pada form `FieldAssignment`).
enum TransportationType {
  MOBIL_DINAS
  KENDARAAN_PRIBADI
  PESAWAT
  KERETA
  BUS
  LAINNYA
}

/// Cara karyawan bekerja pada satu absensi — inti klasifikasi kehadiran.
///
/// Absen di dalam radius kantor selalu `HADIR_DIKANTOR`. Absen di luar radius
/// otomatis tercatat `LUAR_RADIUS` beserta penjelasannya, dan menunggu
/// persetujuan admin (tidak ada WFH — tidak diperbolehkan). `SAKIT` / `IZIN` /
/// `CUTI` hanya bisa muncul di sini kalau admin menimpanya saat menyetujui
/// (`Attendance.approvedMode`) — jalur normalnya adalah pengajuan `LeaveRequest`.
///
/// `LUAR_RADIUS` BEDA dari `FieldAssignment` ("Dinas Luar") di bawah — ini
/// klaim sepihak karyawan saat GPS-nya di luar radius kantor pas absen,
/// bukan penugasan dinas luar yang sudah direncanakan & disetujui duluan.
enum WorkMode {
  HADIR_DIKANTOR
  LUAR_RADIUS
  SAKIT
  IZIN
  CUTI
}

/// Persetujuan admin atas absensi yang terekam di luar radius kantor.
/// `null` pada `Attendance.approvalStatus` berarti absensi di dalam radius —
/// tidak ada yang perlu disetujui.
enum AttendanceApproval {
  /// Menunggu keputusan admin.
  PENDING
  /// Disetujui — mode final ada di `approvedMode ?? workMode`.
  APPROVED
  /// Ditolak: absensinya dianulir, hari itu dihitung Alfa.
  REJECTED
}

/// Status pengajuan pembuatan akun mandiri dari mobile app.
enum AccountRequestStatus {
  /// Menunggu keputusan admin.
  PENDING
  /// Disetujui — akun Clerk + baris User sudah dibuat.
  APPROVED
  /// Ditolak — pemohon boleh mengajukan lagi kapan saja, tidak ada batasan.
  REJECTED
}

/// Pengajuan pembuatan akun dari karyawan yang belum terdaftar (mobile app,
/// layar "Ajukan pembuatan akun"). Password ditulis mentah oleh pemohon di
/// form pengajuan, jadi disimpan terenkripsi (`lib/crypto.ts`) — hanya
/// didekripsi sesaat saat admin menyetujui, untuk dipakai membuat akun Clerk
/// (lihat `reviewAccountRequest` di app/action/account-request.action.ts),
/// lalu dikosongkan lagi. `role` default `EMPLOYEE`, admin boleh menggantinya
/// saat meninjau.
model AccountRequest {
  id                String               @id @default(cuid())
  name              String
  email             String
  phone             String?
  /// Terenkripsi (AES-256-GCM) — lihat lib/crypto.ts. Dikosongkan (null)
  /// begitu request selesai diputuskan (approve/reject), tidak pernah
  /// disimpan lebih lama dari yang perlu.
  passwordEncrypted String?
  role              Role                 @default(EMPLOYEE)
  status            AccountRequestStatus @default(PENDING)

  reviewedBy   User?     @relation("AccountRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, status])
  @@index([status])
}

model User {
  id        String   @id @default(cuid())
  /// ID user di Clerk — sumber kebenaran identitas & password ada di Clerk,
  /// baris ini hanya menyimpan data profil/role aplikasi.
  clerkId   String   @unique
  name      String
  email     String   @unique
  role      Role     @default(EMPLOYEE)
  phone     String?
  position  String?
  /// URL foto profil (`/api/images/<file>`), diisi otomatis dari foto
  /// pendaftaran wajah pertama — lihat app/action/face.action.ts.
  profileImageUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances              Attendance[]      @relation("AttendanceOwner")
  reviewedAttendances      Attendance[]      @relation("AttendanceReviewer")
  leaveRequests            LeaveRequest[]    @relation("LeaveRequester")
  reviewedLeaves           LeaveRequest[]    @relation("LeaveReviewer")
  overtimes                Overtime[]        @relation("OvertimeOwner")
  reviewedOvertimes        Overtime[]        @relation("OvertimeReviewer")
  createdFieldAssignments  FieldAssignment[] @relation("FieldAssignmentCreator")
  fieldAssignments         FieldAssignment[] @relation("FieldAssignmentEmployees")
  reviewedFieldAssignments FieldAssignment[] @relation("FieldAssignmentReviewer")
  approvalLogs             ApprovalLog[]     @relation("ApprovalLogReviewer")
  faceEmbeddings           FaceEmbedding[]
  reviewedAccountRequests  AccountRequest[]  @relation("AccountRequestReviewer")

  /// Bagian profil karyawan di bawah ini masing-masing satu baris per user
  /// (1:1) — "belum ada baris" berarti bagian itu belum pernah diisi, bukan
  /// error. Lihat servers/services/employee-profile.service.ts.
  /// `workHistory` dan `training` beda sendiri: satu user bisa punya banyak
  /// baris (riwayat pekerjaan/pelatihan boleh lebih dari satu).
  personalIdentity       PersonalIdentity?
  contact                Contact?
  employmentData         EmploymentData?
  workHistory            WorkHistory[]
  administrativeDocument AdministrativeDocument?
  payroll                Payroll?
  training               Training[]

  @@index([role, isActive])
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum Religion {
  ISLAM
  KRISTEN
  KATOLIK
  HINDU
  BUDDHA
  KONGHUCU
  LAINNYA
}

enum MaritalStatus {
  BELUM_KAWIN
  KAWIN
  CERAI_HIDUP
  CERAI_MATI
}

enum EmploymentStatus {
  PKWT
  PKWTT
}

/// Identitas pribadi karyawan — 1:1 dengan User. Nama lengkap & email sengaja
/// tidak diduplikasi di sini, dipakai langsung dari User.name/User.email.
model PersonalIdentity {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nik           String        @unique
  placeOfBirth  String
  dateOfBirth   DateTime      @db.Date
  gender        Gender
  religion      Religion
  maritalStatus MaritalStatus
  nationality   String        @default("Indonesia")
  ktpPhotoUrl   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

/// Kontak karyawan — 1:1 dengan User. Nomor HP sengaja tidak diduplikasi,
/// dipakai langsung dari User.phone.
model Contact {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domicileAddress          String
  ktpAddress               String
  emergencyContactName     String
  emergencyContactRelation String
  emergencyContactPhone    String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

/// Data kepegawaian — 1:1 dengan User. Posisi sengaja tidak diduplikasi,
/// dipakai langsung dari User.position.
model EmploymentData {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeNumber   String           @unique
  workLocation     String
  employmentStatus EmploymentStatus
  startDate        DateTime         @db.Date
  contractEndDate  DateTime?        @db.Date
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

/// Riwayat pekerjaan sebelumnya — satu user bisa punya banyak baris (satu per
/// pekerjaan sebelumnya), semua field opsional.
model WorkHistory {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  previousCompany  String?
  previousPosition String?
  previousDuration String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

/// Dokumen administrasi (URL berkas) — 1:1 dengan User, semua field nullable
/// karena diisi bertahap.
model AdministrativeDocument {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ktpUrl        String?
  npwpUrl       String?
  kkUrl         String?
  ijazahUrl     String?
  transkripUrl  String?
  sertifikatUrl String?
  bankBookUrl   String?
  pasFotoUrl    String?
  cvUrl         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Data penggajian — 1:1 dengan User. HANYA admin yang boleh mengubah;
/// karyawan cuma boleh melihat miliknya sendiri (lihat employee-profile.action.ts).
model Payroll {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseSalary                Int
  allowance                 Int?
  bonus                     Int?
  bankAccountNumber         String
  bankAccountName           String
  bpjsKesehatanNumber       String?
  bpjsKetenagakerjaanNumber String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

/// Riwayat training/seminar/sertifikasi — satu user bisa punya banyak baris
/// (satu per pelatihan yang pernah diikuti).
model Training {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Nama pelatihan/seminar/sertifikasi — wajib diisi.
  name      String
  /// Penyelenggara/institusi — opsional.
  organizer String?
  /// Tahun/periode pelaksanaan, bebas format (mis. "2024" atau "Jan–Mar 2025").
  period    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Data wajah referensi karyawan untuk verifikasi 1:1 saat absen (anti titip
/// absen). Satu karyawan bisa punya beberapa baris (3-5 foto enrollment)
/// supaya pencocokan lebih toleran terhadap variasi pencahayaan/sudut.
/// `vector` dihasilkan oleh layanan face recognition (FastAPI + DeepFace) —
/// Next.js tidak pernah menghitungnya sendiri, hanya menyimpan & meneruskannya.
model FaceEmbedding {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  vector    Float[]
  /// Nama model yang menghasilkan vector ini (mis. "ArcFace"). Dicatat supaya
  /// kalau model diganti nanti, embedding lama bisa dibedakan/di-invalidasi
  /// alih-alih diam-diam dibandingkan dengan model yang berbeda.
  model     String
  createdAt DateTime @default(now())

  @@index([userId])
}

model OfficeLocation {
  id           String   @id @default(cuid())
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(100)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Kebijakan waktu kerja yang berlaku untuk semua karyawan (MVP: satu baris aktif).
/// Jam masuk/pulang per hari ada di `WorkDay`.
model WorkSchedule {
  id                   String   @id @default(cuid())
  name                 String   @default("Jam Kerja Standar")
  lateToleranceMinutes Int      @default(15)
  /// Akurasi GPS terburuk yang masih diterima saat absen, dalam meter.
  maxAccuracyMeters    Int      @default(100)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// Satu baris per hari dalam seminggu — selalu 7 baris.
model WorkDay {
  id           String   @id @default(cuid())
  /// 0 = Minggu … 6 = Sabtu, sama dengan `Date#getUTCDay()`
  dayOfWeek    Int      @unique
  isWorkingDay Boolean  @default(true)
  checkInTime  String // "HH:mm"
  checkOutTime String // "HH:mm"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Attendance {
  id     String @id @default(cuid())
  user   User   @relation("AttendanceOwner", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  type      AttendanceType
  /// Tanggal kerja (tanpa jam) — dipakai untuk mencegah absen ganda per hari
  workDate  DateTime       @db.Date
  timestamp DateTime       @default(now())

  /// Null untuk absensi yang dicatat admin manual — tidak ada foto/GPS yang terekam.
  latitude       Float?
  longitude      Float?
  distanceMeters Float?
  /// Akurasi GPS yang dilaporkan perangkat saat absen, dalam meter.
  accuracyMeters Float?
  photoUrl       String?
  isWithinRadius Boolean?
  isLate         Boolean  @default(false)
  /// Menit keterlambatan sejak jam masuk terjadwal, tanpa toleransi — dihitung
  /// berapa pun nilainya, walau di bawah `lateToleranceMinutes` dan `isLate`
  /// tetap false. Dipakai rekap performa/bulanan, bukan untuk label "terlambat".
  lateMinutes    Int      @default(0)

  /// True kalau baris ini dicatat admin secara manual (mis. karyawan lupa absen
  /// pulang), bukan absen langsung dari HP karyawan.
  isManual Boolean @default(false)

  /// Cara kerja absensi ini. Di dalam radius selalu `HADIR_DIKANTOR`; di luar
  /// radius otomatis `LUAR_RADIUS`.
  workMode       WorkMode @default(HADIR_DIKANTOR)
  /// Penjelasan yang wajib diisi karyawan saat absen di luar radius.
  /// Null untuk absensi di dalam radius.
  workModeDetail String?

  /// Diisi hanya kalau absensi terekam di luar radius kantor dan perlu
  /// persetujuan admin. Null = absensi di dalam radius, tidak perlu disetujui.
  approvalStatus AttendanceApproval?
  /// Diisi kalau admin menyetujui dengan mode yang berbeda dari klaim karyawan.
  /// Mode final selalu `approvedMode ?? workMode`.
  approvedMode   WorkMode?
  reviewedBy     User?               @relation("AttendanceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?

  createdAt DateTime @default(now())

  @@unique([userId, workDate, type])
  @@index([workDate])
  @@index([userId, timestamp])
  @@index([approvalStatus, workDate])
}

/// Giliran approval lembur — satu langkah saja, ditentukan dari role pemohon
/// (lihat `resolveInitialOvertime` di `lib/overtime.ts`): karyawan/admin
/// menunggu `SUPERVISOR`, supervisor menunggu `MANAGER`. Penolakan langsung
/// melompat ke `DONE` (lihat `Overtime.status`).
enum OvertimeStage {
  SUPERVISOR
  MANAGER
  DONE
}

model Overtime {
  id     String @id @default(cuid())
  user   User   @relation("OvertimeOwner", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// Tanggal kerja saat lembur dimulai — dipakai untuk grouping/listing.
  workDate DateTime @db.Date
  /// Jam mulai lembur yang dipilih karyawan, selalu >= 18:00 waktu lokal.
  startAt  DateTime
  reason   String

  /// Null selagi lembur masih berjalan.
  endAt           DateTime?
  durationMinutes Int?

  /// Reuse `AttendanceApproval` (PENDING/APPROVED/REJECTED) — makna & nilainya sama.
  status AttendanceApproval @default(PENDING)
  stage  OvertimeStage      @default(SUPERVISOR)

  reviewedBy   User?     @relation("OvertimeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startAt])
  @@index([status, stage])
  @@index([workDate])
}

/// Penugasan dinas luar yang dibuat SUPERVISOR untuk satu/beberapa karyawan,
/// disetujui MANAGER (satu langkah, beda dari LeaveRequest/Overtime yang
/// berjenjang). Beda dari `WorkMode.LUAR_RADIUS` pada `Attendance` — itu klaim
/// karyawan sendiri saat absen di luar radius, ini penugasan yang direncanakan
/// duluan. Begitu disetujui, karyawan yang ditugaskan tidak perlu absen sama
/// sekali pada rentang tanggalnya — lihat `ReportService.buildRecap`.
model FieldAssignment {
  id String @id @default(cuid())

  createdBy   User   @relation("FieldAssignmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  /// Karyawan yang ditugaskan — satu pengajuan bisa untuk beberapa orang sekaligus.
  employees   User[] @relation("FieldAssignmentEmployees")

  startDate           DateTime            @db.Date
  endDate             DateTime            @db.Date
  /// Kegiatan/tujuan dinas luar — sebelumnya bernama `reason`.
  activityDetail      String
  /// "Tujuan Kota".
  destinationCity     String?
  /// "Lokasi/Alamat Tujuan".
  destinationAddress  String?
  /// "Keperluan Dinas" — ringkas, beda dari `activityDetail`.
  purpose             String?
  /// "Nama Perusahaan/Instansi yang Dikunjungi" — satu-satunya field baru yang
  /// tetap opsional walau untuk pengajuan baru.
  companyName         String?
  transportation      TransportationType?
  /// Wajib diisi hanya kalau `transportation` = `LAINNYA`.
  transportationOther String?
  /// Estimasi biaya dalam Rupiah utuh (bukan sen).
  estimatedCost       Int?
  /// Wajib diisi — beda dari `LeaveRequest.attachmentUrl` yang opsional.
  /// Merepresentasikan "Upload rincian biaya".
  attachmentUrl       String

  /// Reuse `AttendanceApproval` (PENDING/APPROVED/REJECTED) — makna & nilainya sama.
  status AttendanceApproval @default(PENDING)

  reviewedBy   User?     @relation("FieldAssignmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startDate, endDate])
}

/// Hari libur nasional / cuti bersama / libur internal perusahaan.
/// Melengkapi `WorkDay` yang hanya mengatur pola mingguan.
model Holiday {
  id        String      @id @default(cuid())
  date      DateTime    @unique @db.Date
  name      String
  type      HolidayType @default(NASIONAL)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model LeaveRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)

  type           LeaveType
  startDate      DateTime             @db.Date
  endDate        DateTime             @db.Date
  /// Elaborasi bebas — sebelumnya bernama `reason`. Wajib untuk ketiga jenis.
  detail         String
  /// Kategori alasan ("Alasan" pada form) — wajib untuk `CUTI`/`IZIN`, wajib
  /// null untuk `SAKIT`. Divalidasi di zod (`leave.validator.ts`), bukan DB.
  reasonCategory LeaveReasonCategory?
  attachmentUrl  String?
  status         LeaveStatus          @default(PENDING)
  /// Giliran approval saat ini — selalu diisi eksplisit saat dibuat lewat
  /// `resolveInitialLeaveStage` (lib/leave.ts), tergantung role pemohon.
  stage          LeaveStage           @default(SUPERVISOR)

  /// Reviewer & catatan dari keputusan TERAKHIR (admin, supervisor, atau
  /// manager, tergantung `stage` saat keputusan itu diambil) — bukan riwayat
  /// lengkap tiap langkah.
  reviewedById String?
  reviewedBy   User?     @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, startDate])
  @@index([status, stage])
}

enum ApprovalLogType {
  LEAVE
  OVERTIME
  FIELD_ASSIGNMENT
}

/// Satu baris per keputusan approve/reject di tiap tahapan — beda dari
/// `reviewedById` di LeaveRequest/Overtime/FieldAssignment yang cuma
/// menyimpan reviewer *terakhir* dan tertimpa tiap kali pengajuan naik
/// tahap, jadi tidak bisa dipakai untuk histori "yang pernah saya putuskan"
/// oleh reviewer tahap awal (mis. admin untuk Izin yang lanjut ke
/// supervisor). Dipakai murni untuk tab Riwayat di halaman Review mobile —
/// bukan sumber kebenaran status pengajuan, itu tetap di tabel asalnya.
model ApprovalLog {
  id String @id @default(cuid())

  type      ApprovalLogType
  requestId String

  reviewer   User               @relation("ApprovalLogReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId String
  /// Role reviewer saat memutuskan — sekaligus tahap approval-nya.
  stage      Role
  status     AttendanceApproval
  note       String?

  /// Ringkasan pengajuan saat diputuskan, didenormalisasi supaya histori
  /// bisa ditampilkan tanpa join ulang ke tabel asal (yang tahap/reviewer
  /// terkininya bisa sudah berubah).
  requesterId   String
  requesterName String
  summary       String

  reviewedAt DateTime @default(now())

  @@index([reviewerId, reviewedAt])
  @@index([type, requestId])
}
