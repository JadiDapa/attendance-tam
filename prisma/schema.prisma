generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  ADMIN
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum LeaveType {
  IZIN
  SAKIT
  CUTI
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HolidayType {
  NASIONAL
  CUTI_BERSAMA
  INTERNAL
}

/// Cara karyawan bekerja pada satu absensi — inti klasifikasi kehadiran.
///
/// Absen di dalam radius kantor selalu `HADIR_DIKANTOR`. Absen di luar radius
/// mewajibkan karyawan memilih `WFH` atau `DINAS_LUAR` beserta penjelasannya,
/// dan menunggu persetujuan admin. `SAKIT` / `IZIN` / `CUTI` hanya bisa muncul
/// di sini kalau admin menimpanya saat menyetujui (`Attendance.approvedMode`) —
/// jalur normalnya adalah pengajuan `LeaveRequest`.
enum WorkMode {
  HADIR_DIKANTOR
  WFH
  DINAS_LUAR
  SAKIT
  IZIN
  CUTI
}

/// Persetujuan admin atas absensi yang terekam di luar radius kantor.
/// `null` pada `Attendance.approvalStatus` berarti absensi di dalam radius —
/// tidak ada yang perlu disetujui.
enum AttendanceApproval {
  /// Menunggu keputusan admin.
  PENDING
  /// Disetujui — mode final ada di `approvedMode ?? workMode`.
  APPROVED
  /// Ditolak: absensinya dianulir, hari itu dihitung Alfa.
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  phone        String?
  position     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendances         Attendance[]    @relation("AttendanceOwner")
  reviewedAttendances Attendance[]    @relation("AttendanceReviewer")
  leaveRequests       LeaveRequest[]  @relation("LeaveRequester")
  reviewedLeaves      LeaveRequest[]  @relation("LeaveReviewer")
  faceEmbeddings      FaceEmbedding[]

  @@index([role, isActive])
}

/// Data wajah referensi karyawan untuk verifikasi 1:1 saat absen (anti titip
/// absen). Satu karyawan bisa punya beberapa baris (3-5 foto enrollment)
/// supaya pencocokan lebih toleran terhadap variasi pencahayaan/sudut.
/// `vector` dihasilkan oleh layanan face recognition (FastAPI + DeepFace) —
/// Next.js tidak pernah menghitungnya sendiri, hanya menyimpan & meneruskannya.
model FaceEmbedding {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  vector    Float[]
  /// Nama model yang menghasilkan vector ini (mis. "ArcFace"). Dicatat supaya
  /// kalau model diganti nanti, embedding lama bisa dibedakan/di-invalidasi
  /// alih-alih diam-diam dibandingkan dengan model yang berbeda.
  model     String
  createdAt DateTime @default(now())

  @@index([userId])
}

model OfficeLocation {
  id           String   @id @default(cuid())
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(100)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Kebijakan waktu kerja yang berlaku untuk semua karyawan (MVP: satu baris aktif).
/// Jam masuk/pulang per hari ada di `WorkDay`.
model WorkSchedule {
  id                   String   @id @default(cuid())
  name                 String   @default("Jam Kerja Standar")
  lateToleranceMinutes Int      @default(15)
  /// Akurasi GPS terburuk yang masih diterima saat absen, dalam meter.
  maxAccuracyMeters    Int      @default(100)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// Satu baris per hari dalam seminggu — selalu 7 baris.
model WorkDay {
  id String @id @default(cuid())
  /// 0 = Minggu … 6 = Sabtu, sama dengan `Date#getUTCDay()`
  dayOfWeek    Int      @unique
  isWorkingDay Boolean  @default(true)
  checkInTime  String // "HH:mm"
  checkOutTime String // "HH:mm"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Attendance {
  id     String @id @default(cuid())
  user   User   @relation("AttendanceOwner", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  type      AttendanceType
  /// Tanggal kerja (tanpa jam) — dipakai untuk mencegah absen ganda per hari
  workDate  DateTime       @db.Date
  timestamp DateTime       @default(now())

  /// Null untuk absensi yang dicatat admin manual — tidak ada foto/GPS yang terekam.
  latitude       Float?
  longitude      Float?
  distanceMeters Float?
  /// Akurasi GPS yang dilaporkan perangkat saat absen, dalam meter.
  accuracyMeters Float?
  photoUrl       String?
  isWithinRadius Boolean?
  isLate         Boolean  @default(false)

  /// True kalau baris ini dicatat admin secara manual (mis. karyawan lupa absen
  /// pulang), bukan absen langsung dari HP karyawan.
  isManual Boolean @default(false)

  /// Cara kerja yang diklaim karyawan saat absen. Di dalam radius selalu
  /// `HADIR_DIKANTOR`; di luar radius karyawan wajib memilih `WFH`/`DINAS_LUAR`.
  workMode WorkMode @default(HADIR_DIKANTOR)
  /// Penjelasan yang wajib diisi karyawan saat absen di luar radius.
  /// Null untuk absensi di dalam radius.
  workModeDetail String?

  /// Diisi hanya kalau absensi terekam di luar radius kantor dan perlu
  /// persetujuan admin. Null = absensi di dalam radius, tidak perlu disetujui.
  approvalStatus AttendanceApproval?
  /// Diisi kalau admin menyetujui dengan mode yang berbeda dari klaim karyawan.
  /// Mode final selalu `approvedMode ?? workMode`.
  approvedMode WorkMode?
  reviewedBy   User?     @relation("AttendanceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())

  @@unique([userId, workDate, type])
  @@index([workDate])
  @@index([userId, timestamp])
  @@index([approvalStatus, workDate])
}

/// Hari libur nasional / cuti bersama / libur internal perusahaan.
/// Melengkapi `WorkDay` yang hanya mengatur pola mingguan.
model Holiday {
  id        String      @id @default(cuid())
  date      DateTime    @unique @db.Date
  name      String
  type      HolidayType @default(NASIONAL)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model LeaveRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)

  type          LeaveType
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  reason        String
  attachmentUrl String?
  status        LeaveStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, startDate])
}
